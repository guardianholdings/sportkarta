# Caddy v2 — IP-only mode: plain HTTP on :80, no TLS, no subdomains.
# deploy.yml ships THIS file as the server's Caddyfile while the PROD_DOMAIN
# secret is unset, and deploy/Caddyfile (Let's Encrypt + subdomains) once it
# is set. Umami and GlitchTip stay reachable only inside the compose network
# in this mode — they get their subdomains back with the domain.

:80 {
	encode zstd gzip

	# Self-served Protomaps tiles (Stage 2). file_server handles HTTP range
	# requests natively — required for .pmtiles.
	handle_path /tiles/* {
		root * /srv/tiles
		file_server
		header Cache-Control "public, max-age=86400"
		header Access-Control-Allow-Origin "*"
	}

	handle {
		reverse_proxy web:3000
	}
}
