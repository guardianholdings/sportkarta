# Caddy v2 — IP-only mode: plain HTTP on :80, no TLS, no subdomains.
# deploy.yml ships THIS file as the server's Caddyfile while the PROD_DOMAIN
# secret is unset, and deploy/Caddyfile (Let's Encrypt + subdomains) once it
# is set. Umami and GlitchTip stay reachable only inside the compose network
# in this mode — they get their subdomains back with the domain.

:80 {
	header -Server
	encode zstd gzip

	# Self-served Protomaps tiles (Stage 2). file_server handles HTTP range
	# requests natively — required for .pmtiles.
	handle_path /tiles/* {
		root * /srv/tiles
		file_server
		header Cache-Control "public, max-age=86400"
		header Access-Control-Allow-Origin "*"
	}

	handle {
		reverse_proxy web:3000
	}

	# Same "updating" page as the TLS Caddyfile, for the same reason.
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		header Retry-After "20"
		respond <<HTML
			<!doctype html>
			<html lang="bg"><head><meta charset="utf-8">
			<meta name="viewport" content="width=device-width,initial-scale=1">
			<meta http-equiv="refresh" content="15">
			<title>POPS се обновява</title>
			<style>body{font-family:system-ui,sans-serif;background:#faf7f2;color:#1d1b16;display:grid;place-items:center;min-height:100vh;margin:0;padding:24px;text-align:center}h1{font-size:1.4rem;margin:0 0 .5rem}p{margin:.25rem 0;color:#5c5647}</style>
			</head><body><main>
			<h1>POPS се обновява</h1>
			<p>След няколко секунди сме отново тук — страницата ще се презареди сама.</p>
			<p lang="en">POPS is updating — back in a few seconds. This page reloads by itself.</p>
			</main></body></html>
			HTML 503
	}
}
