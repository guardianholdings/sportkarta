# Caddy v2 — automatic Let's Encrypt for every host below.
# DOMAIN, LEGACY_HOSTS and ADMIN_TOOLS_HASH come from /opt/sportkarta/.env via
# compose.
#
# The site's own names are PROXIED by Cloudflare (orange-cloud DNS records):
# visitors reach Cloudflare's edge, and Cloudflare reaches this server. Three
# things follow, each handled below: whose address a request comes from and how
# this server gets its certificates (the global options), and what Cloudflare
# may keep copies of (`@edge_never`). The legacy sslip.io name is not proxied,
# and everything here is equally correct for direct traffic.
{
	servers {
		# Whose address is it? Through Cloudflare the TCP peer is Cloudflare's
		# edge, and the visitor's address arrives in CF-Connecting-IP, which
		# Cloudflare sets itself, overwriting anything the visitor sent. It is
		# believed ONLY when the peer is inside Cloudflare's published ranges
		# (https://www.cloudflare.com/ips/, fetched 2026-10-03; they change
		# rarely, and a missing range only makes those visitors share a
		# rate-limit bucket). From anywhere else the header is the visitor's own
		# claim and the TCP peer stands. {client_ip} is the result.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}

	# Certificates. Cloudflare terminates the visitor's TLS at its edge, so the
	# TLS-ALPN-01 challenge can never reach this server; HTTP-01 can, because
	# Cloudflare forwards plain-HTTP requests to port 80 unchanged — which is
	# why its "Always Use HTTPS" must stay OFF (Caddy redirects to HTTPS
	# itself). Offering only the challenge that works keeps every issuance and
	# renewal from first burning a failed validation.
	cert_issuer acme {
		disable_tlsalpn_challenge
	}
}

# Shared by every host. HSTS without includeSubDomains/preload on purpose: the
# same snippet covers the server's borrowed wildcard-DNS name (sslip.io, see
# LEGACY_HOSTS), and those flags would make a promise about hosts we do not own.
(hardening) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# What every proxied app is told about the visitor: exactly one address, the
# one resolved in the global options. The web app keys its rate limits on the
# LAST X-Forwarded-For hop (apps/web/lib/rate-limit.ts) and better-auth on the
# last untrusted one; Caddy's default would append Cloudflare's edge as that
# hop, and every visitor would share one bucket. CF-Connecting-IP is dropped so
# nothing behind this proxy can mistake a forged one for the real thing.
(visitor_address) {
	header_up X-Forwarded-For {client_ip}
	header_up -CF-Connecting-IP
}

# The two operator dashboards (Umami, GlitchTip) are for the operator only.
# Neither app's own login was ever set up — Umami shipped with its documented
# default admin password, and GlitchTip lets whoever registers first own the
# instance — so a second lock sits in front of both. deploy.yml renders the hash
# from the ADMIN_TOOLS_PASSWORD secret (user "admin"); with that secret unset
# the hash is of a random throwaway and the dashboards are closed to everyone.
(operator_only) {
	basic_auth {
		admin {$ADMIN_TOOLS_HASH}
	}
}

{$DOMAIN} {
	import hardening
	encode zstd gzip

	# What Cloudflare's edge may keep a copy of: only what is the same for
	# everyone and never withdrawn — the content-hashed build assets, the map
	# glyphs and the app icons. Everything else is decided per request by the
	# app (a photo can be taken down, a passport made private, a partner
	# hidden), and an edge copy would go on serving it after the decision.
	# Cloudflare-CDN-Cache-Control is read by Cloudflare alone; the browser's
	# caching stays with the app's own Cache-Control.
	@edge_never not path /_next/static/* /fonts/* /icons/*
	header @edge_never Cloudflare-CDN-Cache-Control "no-store"

	# Self-served Protomaps tiles (Stage 2). file_server handles HTTP range
	# requests natively — required for .pmtiles.
	handle_path /tiles/* {
		root * /srv/tiles
		file_server
		header Cache-Control "public, max-age=86400"
		header Access-Control-Allow-Origin "*"
	}

	handle {
		reverse_proxy web:3000 {
			import visitor_address
		}
	}

	# While a deploy swaps the web container (or it restarts), the proxy has
	# nothing to talk to. Without this the visitor gets Caddy's empty 502 — a
	# blank page that reads as "the site is dead". This says what is happening,
	# in both languages, and reloads itself.
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		header Retry-After "20"
		respond <<HTML
			<!doctype html>
			<html lang="bg"><head><meta charset="utf-8">
			<meta name="viewport" content="width=device-width,initial-scale=1">
			<meta http-equiv="refresh" content="15">
			<title>POPS се обновява</title>
			<style>body{font-family:system-ui,sans-serif;background:#faf7f2;color:#1d1b16;display:grid;place-items:center;min-height:100vh;margin:0;padding:24px;text-align:center}h1{font-size:1.4rem;margin:0 0 .5rem}p{margin:.25rem 0;color:#5c5647}</style>
			</head><body><main>
			<h1>POPS се обновява</h1>
			<p>След няколко секунди сме отново тук — страницата ще се презареди сама.</p>
			<p lang="en">POPS is updating — back in a few seconds. This page reloads by itself.</p>
			</main></body></html>
			HTML 503
	}
}

umami.{$DOMAIN} {
	import hardening

	# The tracker script and its beacon must stay public, or analytics would
	# count nobody; they accept events and reveal nothing.
	@tracker path /script.js /api/send /api/batch
	handle @tracker {
		reverse_proxy umami:3000 {
			import visitor_address
		}
	}

	handle {
		import operator_only
		reverse_proxy umami:3000 {
			import visitor_address
		}
	}
}

glitchtip.{$DOMAIN} {
	import hardening

	# Error-report ingestion must stay public — browsers post their errors here
	# — and each request is authenticated by the project's DSN key.
	@ingest path_regexp ^/api/[0-9]+/(envelope|store|security|minidump)/
	handle @ingest {
		reverse_proxy glitchtip:8000 {
			import visitor_address
		}
	}

	handle {
		import operator_only
		reverse_proxy glitchtip:8000 {
			import visitor_address
		}
	}
}

# The other names the site answers to, each with its own certificate and a
# permanent redirect to the canonical host: www, and LEGACY_HOSTS — the
# server's sslip.io name, where the site lived before it had a domain, so early
# links, bookmarks and printed QR codes point there. deploy.yml renders
# LEGACY_HOSTS and it may be empty; Caddy expands an env placeholder before it
# parses, so the line then simply lists one address. 308 keeps method and path.
www.{$DOMAIN} {$LEGACY_HOSTS} {
	import hardening
	redir https://{$DOMAIN}{uri} 308
}

# Anything that arrives over plain HTTP addressed to none of the hosts above
# — most importantly the raw server IP, which is where the earliest links and
# bookmarks point — is redirected to the canonical host rather than dropped.
#
# Without this the switch from IP-only mode reads as an outage: Caddy answers a
# non-matching host with an empty 200 or a closed connection, and the previous
# URL simply stops working. It also matters for correctness beyond convenience:
# geolocation, and therefore every point a contribution can earn, requires the
# secure origin, so anyone still on the bare-IP URL would keep silently scoring
# nothing. 308 preserves the method and the path. ACME HTTP-01 challenges on
# this port are answered by Caddy before any route, this one included.
:80 {
	redir https://{$DOMAIN}{uri} 308
}
