{
  "name": "@sportkarta/import-osm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --target=node22 --format=esm --external:pg --external:dotenv --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "audit": "tsx src/audit-cli.ts"
  },
  "dependencies": {
    "@sportkarta/lib": "workspace:*",
    "dotenv": "^16.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
