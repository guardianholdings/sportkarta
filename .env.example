# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 16 + PostGIS connection string.
# Used by: apps/web, apps/worker (pg-boss), db (drizzle-kit migrate).
# The local dev value will match compose.dev.yml (arrives in Session 0.3).
DATABASE_URL=postgres://sportkarta:sportkarta@localhost:5432/sportkarta

# ─── File storage ────────────────────────────────────────────────────────────
# Directory backing the local-volume storage adapter (lib/src/storage).
# In Docker this is a mounted volume; locally any writable directory works.
# Relative paths are resolved from the process working directory.
STORAGE_DIR=./.data/storage

# ─── Web ─────────────────────────────────────────────────────────────────────
# Canonical public origin of the site (SEO, sitemap, absolute URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (Stage 4 — documented ahead of use; unused by the scaffold) ───────
# Commodity SMTP relay, provider-agnostic (docs/ROADMAP.md §0).
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=postmaster@example.org
# SMTP_PASS=changeme
# SMTP_FROM="SportKarta <no-reply@example.org>"
