# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 16 + PostGIS connection string.
# Used by: apps/web, apps/worker (pg-boss), db (drizzle-kit migrate).
# Local dev: compose.dev.yml publishes Postgres on host port 5433
# (5432 is commonly taken by other local databases).
DATABASE_URL=postgres://sportkarta:sportkarta@localhost:5433/sportkarta

# ─── File storage ────────────────────────────────────────────────────────────
# Directory backing the local-volume storage adapter (lib/src/storage).
# In Docker this is a mounted volume; locally any writable directory works.
# Relative paths are resolved from the process working directory.
STORAGE_DIR=./.data/storage

# ─── Web ─────────────────────────────────────────────────────────────────────
# Canonical public origin of the site (SEO, sitemap, absolute URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional contact email shown on the privacy page. If unset, the page points
# visitors to the per-facility "Report a problem" form instead. Read at runtime
# by the server, so it can be changed via compose without a rebuild.
# CONTACT_EMAIL=hello@example.org

# ─── Analytics & error monitoring (optional; empty = disabled) ───────────────
# Self-hosted, cookieless Umami. Set BOTH to enable the tracking snippet.
# UMAMI_SRC is the full URL of Umami's script.js; UMAMI_WEBSITE_ID is the
# site UUID from the Umami dashboard. Non-public names → read at runtime, so
# they apply via compose without rebuilding the image.
# UMAMI_SRC=https://umami.example.org/script.js
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# Self-hosted GlitchTip (Sentry-compatible) DSN for client-side error
# monitoring. Empty disables it (no @sentry/browser chunk is loaded).
# GLITCHTIP_DSN=https://publicKey@glitchtip.example.org/1

# ─── Admin (temporary until Stage 3 better-auth) ─────────────────────────────
# Comma-separated name:token allowlist for /admin. The name becomes the
# `actor` on audit rows — one entry per person, tokens ≥12 chars, rotate by
# editing this variable. TODO(stage-3): replaced by better-auth.
ADMIN_TOKENS=pavel:change-me-to-a-long-random-secret

# ─── Email (Stage 4 — documented ahead of use; unused by the scaffold) ───────
# Commodity SMTP relay, provider-agnostic (docs/ROADMAP.md §0).
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=postmaster@example.org
# SMTP_PASS=changeme
# SMTP_FROM="SportKarta <no-reply@example.org>"
