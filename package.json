{
  "name": "sportkarta",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sportkarta/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @sportkarta/web test:e2e",
    "db:start": "docker compose -f compose.dev.yml up -d --wait db",
    "db:generate": "pnpm --filter @sportkarta/db db:generate",
    "db:migrate": "pnpm --filter @sportkarta/db db:migrate",
    "db:seed": "pnpm --filter @sportkarta/db db:seed",
    "db:reset": "bash scripts/db-reset.sh",
    "mod:queue": "pnpm --filter @sportkarta/db run mod:queue",
    "mod:flag": "pnpm --filter @sportkarta/db run mod:flag",
    "import:osm": "pnpm --filter @sportkarta/import-osm run cli",
    "import:osm:audit": "pnpm --filter @sportkarta/import-osm run audit",
    "tiles:build": "bash scripts/build-tiles/build.sh",
    "stats:launch-report": "pnpm --filter @sportkarta/launch-report run report"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@next/eslint-plugin-next": "^15.3.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0"
  }
}
