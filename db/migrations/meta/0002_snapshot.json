        "facilities_sport_types_no_blanks": {
          "name": "facilities_sport_types_no_blanks",
          "value": "array_position(\"facilities\".\"sport_types\", NULL) IS NULL AND array_position(\"facilities\".\"sport_types\", '') IS NULL"
        },
        "facilities_geom_in_bulgaria": {
          "name": "facilities_geom_in_bulgaria",
          "value": "ST_X(\"facilities\".\"geom\") BETWEEN 22.0 AND 29.0 AND ST_Y(\"facilities\".\"geom\") BETWEEN 41.0 AND 44.5"
        },
        "facilities_osm_ref_pair": {
